#!/usr/bin/env bash

set -euo pipefail

OUTPUT_FILE="${1:-$(pwd)/assets/licenses.md}"

if [ -s "$OUTPUT_FILE" ]; then
    echo "Licenses file already exists ($OUTPUT_FILE). Skipping cargo-about."
    exit 0
fi

echo -n "" >"$OUTPUT_FILE"

{
    echo -e "# ###### THEME LICENSES ######\n"
    [ -f assets/themes/LICENSES ] && cat assets/themes/LICENSES

    echo -e "\n# ###### ICON LICENSES ######\n"
    [ -f assets/icons/LICENSES ] && cat assets/icons/LICENSES

    echo -e "\n# ###### CODE LICENSES ######\n"
    echo "Zed is released under the GNU General Public License v3 (or later) and Apache 2.0 / MIT."
    echo "For full details on third-party licenses and code dependencies, see https://github.com/zed-industries/zed"
} >>"$OUTPUT_FILE"

echo "generate-licenses completed. See $OUTPUT_FILE"

