[
  {
    "context": "Editor",
    "use_key_equivalents": true,
    "bindings": {
      "shift-alt-f": "editor::Format",
      "cmd-k cmd-f": "editor::FormatSelections",
      "shift-alt-i": "editor::SplitSelectionIntoLines",
      "alt-z": "editor::ToggleSoftWrap",
      "cmd-shift-space": "editor::ShowSignatureHelp",
      "ctrl-shift-cmd-right": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-cmd-left": "editor::SelectSmallerSyntaxNode",
      "cmd-k cmd-c": ["editor::ToggleComments", { "advance_downwards": false}],
      "cmd-k f12": "editor::GoToDefinitionSplit"
    }
  },
  {
    "context": "Editor && mode == full",
    "use_key_equivalents": true,
    "bindings": {
      "cmd-k z": "workspace::ToggleCenteredLayout",
      "shift-alt-h": "call_hierarchy::ShowIncomingCalls"
    }
  },
  {
    "context": "!AcpThread > Editor && mode == full",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-enter": null
    }
  },
  {
    "context": "Terminal",
    "use_key_equivalents": true,
    "bindings": {
      "ctrl-enter": null
    }
  },
  {
    "context": "BufferSearchBar || ProjectSearchBar",
    "use_key_equivalents": true,
    "bindings": {
      "alt-cmd-r": "search::ToggleRegex"
    }
  },
  {
    "context": "Workspace && debugger_running",
    "use_key_equivalents": true,
    "bindings": {
      "f5": null
    }
  },
  {
    "context": "CallHierarchyPicker > Picker > Editor",
    "use_key_equivalents": true,
    "bindings": {
      "shift-alt-h": "call_hierarchy::ToggleDirection"
    }
  }
]
